TRACEFIX_SECRET=change-this-local-secret
TRACEFIX_DB_PATH=./tracefix.db
TRACEFIX_ALLOW_MOCK_FALLBACK=true
FRONTEND_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# LLM Gateway (OpenAI-compatible)
TRACEFIX_LLM_PROVIDER=custom
TRACEFIX_LLM_BASE_URL=https://imllm.intermesh.net/v1
TRACEFIX_LLM_MODEL=openrouter/anthropic/claude-sonnet-4.6
TRACEFIX_LLM_API_KEY=
